    given-names: "Petrouil"
    email: "pfanioudakis@gmail.com"
date-released: "2026-08-05"
version: "0.1.0-paper"
keywords:
  - "llama.cpp"
  - "KV cache"
  - "quantization"
  - "FlashAttention"
license: MIT
